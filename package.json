{
    "name": "katex-canvas",
    "version": "0.1.0",
    "description": "Draw KaTeX formulas on a 2D canvas (unofficial, not affiliated with KaTeX)",
    "keywords": [
        "katex",
        "canvas",
        "math",
        "latex",
        "tex",
        "typesetting"
    ],
    "license": "MIT",
    "author": "Michael Strobel",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/strobelm/katex-canvas.git"
    },
    "type": "module",
    "exports": {
        ".": {
            "types": "./src/index.d.ts",
            "default": "./src/index.mjs"
        },
        "./package.json": "./package.json"
    },
    "types": "./src/index.d.ts",
    "files": [
        "src",
        "CHANGELOG.md"
    ],
    "sideEffects": false,
    "peerDependencies": {
        "katex": ">=0.18.9 <0.20"
    },
    "devDependencies": {
        "@playwright/test": "^1.62.0",
        "chai": "^4.3.4",
        "katex": "0.19.0",
        "mocha": "^11.0.0",
        "prettier": "^3.6.0",
        "typescript": "^5.8.3",
        "yaml": "^2.9.1"
    },
    "scripts": {
        "test": "mocha test/unit",
        "test:browser": "playwright test --config test/browser/playwright.config.mjs",
        "test:types": "tsc -p test/types",
        "corpus": "node test/corpus/fetch.mjs",
        "format": "prettier --write .",
        "test:engines": "playwright test --config test/browser/playwright.engines.config.mjs"
    },
    "engines": {
        "node": ">=18"
    },
    "homepage": "https://strobelm.github.io/katex-canvas/examples/",
    "bugs": {
        "url": "https://github.com/strobelm/katex-canvas/issues"
    }
}
